{
  "name": "nodejs-docs-book",
  "version": "0.1.0",
  "private": true,
  "description": "Build unofficial EPUB editions of the Node.js Learn documentation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dcavalcante/nodejs-docs-ebook.git"
  },
  "bin": {
    "nodejs-docs-book": "bin/nodejs-docs-ebook.js"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('lib', {recursive:true, force:true})\"",
    "compile": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prebuild": "npm run compile",
    "build": "node bin/nodejs-docs-ebook.js build",
    "check-updates": "npm run compile && node bin/nodejs-docs-ebook.js check-updates",
    "doctor": "npm run compile && node bin/nodejs-docs-ebook.js doctor",
    "test": "npm run compile && node --test lib/test/*.test.js",
    "prepack": "npm run clean && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
